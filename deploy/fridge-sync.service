[Unit]
Description=Rebuild the fridge page from the Meal Prep Data sheet
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Filled in by the deploy step: the user who owns ~/fridge, and the checkout path.
User=__USER__
WorkingDirectory=__REPO__
ExecStart=/usr/bin/python3 -I __REPO__/fridge.py
